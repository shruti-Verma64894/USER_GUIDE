
{
  "websites": [
    {
      "id": "public",
      "name": "GovCon360 Public",
      "startUrlEnv": "PUBLIC_URL",
      "auth": {
        "enabled": false
      }
    },
    {
      "id": "admin",
      "name": "GovCon360 Admin",
      "startUrlEnv": "ADMIN_URL",
      "usernameEnv": "ADMIN_USERNAME",
      "passwordEnv": "ADMIN_PASSWORD",
     "auth": {
      "enabled": true,
      "usernameSelector": "#exampleInputEmail1",
      "passwordSelector": "#exampleInputPassword1",
      "submitSelector": "button[type='submit'].submit_btn"    }
    },
    {
      "id": "client",
      "name": "GovCon360 Client",
      "startUrlEnv": "CLIENT_URL",
      "usernameEnv": "CLIENT_USERNAME",
      "passwordEnv": "CLIENT_PASSWORD",
      "auth": {
        "enabled": true,
        "usernameSelector": "#username",
        "passwordSelector": "#password",
        "submitSelector": "#kc-login"
      }
    }
  ],
  "browser": {
    "headless": false,
    "width": 1440,
    "height": 900
  },
  "crawler": {
    "waitTime": 1500,
    "delayBetweenPages": 500,
    "timeout": 90000,
    "waitUntil": "networkidle",
    "sameDomainOnly": true,
    "removeQueryParameters": true,
    "maxEntryLinksPerPage": 1,
    "maxPages": 5
  },
  "output": {
    "folder": "output",
    "saveIndividualJson": true,
    "saveScreenshots": true,
    "saveSummary": true,
    "fullPageScreenshot": true
  }
}
